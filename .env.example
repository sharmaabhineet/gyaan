# Gyaan model provider configuration
#
# Copy this file to .env and adjust as needed for local reference.
# Gyaan does not load .env files automatically; these variables must
# be exported into your shell (or your process manager of choice)
# before running `gyaan`.

# GYAAN_PROVIDER selects which ChatModel implementation Gyaan uses.
# Supported values: echo (default), openai, ollama.

# --- Echo (default) ---
# No configuration required. Echo does not call an LLM.
GYAAN_PROVIDER=echo

# --- OpenAI ---
# Requires an OpenAI API key and account credits.
# GYAAN_PROVIDER=openai
# GYAAN_MODEL=<openai-model-name>
# OPENAI_API_KEY=<your-openai-api-key>

# --- Ollama ---
# Requires a local Ollama installation with the model already pulled.
# GYAAN_PROVIDER=ollama
# GYAAN_MODEL=<ollama-model-name>
